void drawBorder() {
    for (int x = 0; x < CANVAS_WIDTH; x++) {
        canvas[0][x] = '#';
        canvas[CANVAS_HEIGHT - 1][x] = '#';
    }

    for (int y = 0; y < CANVAS_HEIGHT; y++) {
        canvas[y][0] = '#';
        canvas[y][CANVAS_WIDTH - 1] = '#';
    }
}


#include <stdio.h>

void drawLine() {
    printf("Line drawing feature will be implemented later.\n");
}

void drawRectangle() {
    printf("Rectangle drawing feature will be implemented later.\n");
}

void drawCircle() {
    printf("Circle drawing feature will be implemented later.\n");
}

int main() {
    int choice;

    do {
        printf("\n===== 2D Graphics Editor =====\n");
        printf("1. Draw Line\n");
        printf("2. Draw Rectangle\n");
        printf("3. Draw Circle\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice) {
            case 1:
                drawLine();
                break;
            case 2:
                drawRectangle();
                break;
            case 3:
                drawCircle();
                break;
            case 4:
                printf("Exiting program...\n");
                break;
            default:
                printf("Invalid choice!\n");
        }
    } while(choice != 4);

    return 0;
}
